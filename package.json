{
  "name": "woocommerce-mercadopago",
  "description": "Woocommerce MercadoPago Payment Gateway",
  "version": "8.9.3",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/mercadopago/cart-woocommerce"
  },
  "engines": {
    "node": "^20.0.0"
  },
  "scripts": {
    "setup:st": "node -e 'require(\"./main.js\").setupSuperToken()'",
    "build": "npm run build:narciso && npm run build:js && npm run build:css && npm run build:webpack && npm run build:super-token:webpack && npm run build:super-token:bundle && npm run build:integrity",
    "build:integrity": "node -e 'require(\"./main.js\").generateIntegrityManifest()'",
    "verify:integrity": "node bin/verify-integrity.js",
    "build:js": "node -e 'require(\"./main.js\").minifyFiles(\"js\")'",
    "build:css": "node -e 'require(\"./main.js\").minifyFiles(\"css\")'",
    "build:super-token:bundle": "node -e 'require(\"./main.js\").buildSuperTokenAssets()'",
    "build:webpack": "wp-scripts build assets/js/blocks/**.js",
    "prebuild:super-token:webpack": "rm -rf build/super-token build/super-token-v2 build/super-token-v2.1",
    "build:super-token:webpack": "ST_UNMINIFIED=1 wp-scripts build assets/js/checkouts/super-token/bootstrap.ts --output-path=build/super-token && ST_UNMINIFIED=1 ST_FIXED_VARIANT=v2 wp-scripts build assets/js/checkouts/super-token/bootstrap.ts --output-path=build/super-token-v2 && ST_UNMINIFIED=1 ST_FIXED_VARIANT=v2.1 wp-scripts build assets/js/checkouts/super-token/bootstrap.ts --output-path=build/super-token-v2.1",
    "postbuild:super-token:webpack": "cp index.php build/super-token && cp index.php build/super-token-v2 && cp index.php build/super-token-v2.1",
    "postbuild:webpack": "cp index.php build",
    "type-check": "tsc --noEmit",
    "lint": "eslint assets/**/*.js assets/**/*.ts",
    "lint:fix": "eslint assets/**/*.js assets/**/*.ts --fix",
    "lint:css": "stylelint \"assets/css/checkouts/super-token/**/*.scss\"",
    "verify:super-token:scss": "node scripts/verify-super-token-scss-equivalence.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:mutation": "npx --yes -p @stryker-mutator/core@^9.6 -p @stryker-mutator/jest-runner@^9.6 stryker run",
    "pot": "node -e 'require(\"./main.js\").generatePotFiles()'",
    "build:narciso": "bash ./packages/narciso/bin/pre-assets.sh && webpack --mode=production --config narciso.webpack.config.js && bash ./packages/narciso/bin/post-assets.sh",
    "watch:build": "SHELL=/bin/sh chokidar assets packages/narciso -i '**/*.min.*' -i assets/images -c 'npm run build' --initial",
    "watch:release": "SHELL=/bin/sh chokidar . -i woocommerce-mercadopago.zip -c 'make build'",
    "watch:logs": "SHELL=/bin/sh chokidar /var/www/html/wp-content/uploads/wc-logs /var/www/html/wp-content/debug.log -c 'cp /var/www/html/wp-content/uploads/wc-logs/*.log /var/www/html/wp-content/debug.log /var/www/html/wp-content/plugins/woocommerce-mercadopago/logs' --initial",
    "watch:make-mo": "SHELL=/bin/sh chokidar i18n/languages/*.po -c 'wp --allow-root i18n make-mo i18n/languages i18n/languages'",
    "logs:clear": "rm -f /var/www/html/wp-content/uploads/wc-logs/*.log /var/www/html/wp-content/debug.log /var/www/html/wp-content/plugins/woocommerce-mercadopago/logs/*.log",
    "clean:min": "find assets/css assets/js -type f \\( -name '*.min.css' -o -name '*.min.js' \\) -delete"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.26.0",
    "@eslint/js": "^9.20.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@woocommerce/dependency-extraction-webpack-plugin": "^3.1.0",
    "@woocommerce/eslint-plugin": "^2.3.0",
    "@wordpress/scripts": "^30.11.0",
    "babel-jest": "^30.2.0",
    "chokidar-cli": "^3.0.0",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jsdoc": "^46.10.1",
    "eslint-plugin-react": "7.37.5",
    "globals": "^15.15.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "minify": "^7.2.2",
    "sass": "~1.80.7",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "typescript": "^5.7.3",
    "webpack-cli": "^6.0.1",
    "wp-pot": "^1.10.2"
  }
}
