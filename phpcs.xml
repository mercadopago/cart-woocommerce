<?xml version="1.0"?>
<ruleset name="Woocommerce Coding Standards">
    <description>PHP_CodeSniffer ruleset for Woocommerce MercadoPago.</description>

    <!-- Rules-->
    <rule ref="PSR12">
        <exclude name="PSR1.Files.SideEffects" />
        <exclude name="PSR1.Methods.CamelCapsMethodName.NotCamelCaps" />
        <exclude name="Generic.Files.LineLength.TooLong" />
    </rule>

    <!-- Security sniffs: single source shared with bin/phpcs-security.sh and composer phpcs:security. -->
    <rule ref="./phpcs-security.xml" />

    <rule ref="PHPCompatibility" />

    <!-- Exclude paths -->
    <!-- PHPCS reads these as regular expressions: anchor the extension so that a directory name with
         "js" or "css" in the checkout or temporary path does not exclude every PHP file. -->
    <exclude-pattern>\.js$</exclude-pattern>
    <exclude-pattern>\.css$</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
</ruleset>
