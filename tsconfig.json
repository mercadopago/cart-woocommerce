{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@super-token/*": ["./assets/js/checkouts/super-token/*"]
    },
    "types": []
  },
  "include": ["assets/js/checkouts/super-token/**/*.ts"]
}
