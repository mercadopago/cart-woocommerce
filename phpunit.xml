<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    bootstrap="tests/bootstrap.php"
    backupGlobals="false"
	colors="true"
	convertErrorsToExceptions="true"
	convertNoticesToExceptions="true"
	convertWarningsToExceptions="true"
    convertDeprecationsToExceptions="true"
    verbose="true">
    <php>
        <!--
            The full suite peaks at about 150 MB, above PHP's default 128M limit
            (mostly WP_Mock/Mockery state retained across tests). With Xdebug coverage
            the CI run ends at about 210-230 MB and the HTML report then needs more, so
            256M failed with a fatal memory error after all tests passed.
            Profile the heaviest tests (e.g. AbstractGatewayTest, WordPressHttpClientTest)
            before raising it again.
        -->
        <ini name="memory_limit" value="512M"/>
        <env name="PHPUNIT_TEST" value="true"/>
    </php>

    <testsuites>
        <testsuite name="default">
            <directory suffix="Test.php">tests</directory>
        </testsuite>
    </testsuites>

    <coverage cacheDirectory=".phpunit.cache/code-coverage">
        <include>
            <directory suffix=".php">src/Api</directory>
            <directory suffix=".php">src/Gateways</directory>
            <directory suffix=".php">src/Transactions</directory>
            <directory suffix=".php">src/Exceptions</directory>
            <directory suffix=".php">src/Helpers</directory>
            <directory suffix=".php">src/Order</directory>
            <directory suffix=".php">src/Notification</directory>
            <directory suffix=".php">src/SmartPix</directory>
            <directory suffix=".php">src/SuperToken</directory>
            <directory suffix=".php">src/Refund</directory>
            <directory suffix=".php">src/Hooks</directory>
            <directory suffix=".php">src/HealthMonitor</directory>
            <directory suffix=".php">src/Blocks</directory>
            <directory suffix=".php">src/Libraries</directory>
        </include>
        <exclude>
            <file>src/Api/index.php</file>
            <directory suffix="index.php">src/Api</directory>
            <directory suffix="index.php">src/Gateways</directory>
            <directory suffix="index.php">src/Transactions</directory>
            <directory suffix="index.php">src/Exceptions</directory>
            <directory suffix="index.php">src/Helpers</directory>
            <directory suffix="index.php">src/Order</directory>
            <directory suffix="index.php">src/Notification</directory>
            <directory suffix="index.php">src/SuperToken</directory>
            <directory suffix="index.php">src/Refund</directory>
            <directory suffix="index.php">src/Hooks</directory>
            <directory suffix="index.php">src/HealthMonitor</directory>
            <directory suffix="index.php">src/Blocks</directory>
            <directory suffix="index.php">src/Libraries</directory>
        </exclude>
        <report>
            <text outputFile="php://stdout" showOnlySummary="true"/>
        </report>
    </coverage>
</phpunit>
