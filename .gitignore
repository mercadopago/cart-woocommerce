# SSL certificates (local dev)
*.pem

# Super Token webpack entry output — regenerated by build:super-token:webpack (runtime bundle plus
# the per-variant retrocompat builds, PSW-4417). Keeps the index.php stub trackable.
/build/super-token/*.js
/build/super-token/*.js.map
/build/super-token/*.asset.php
/build/super-token-v2/*.js
/build/super-token-v2/*.js.map
/build/super-token-v2/*.asset.php
/build/super-token-v2.1/*.js
/build/super-token-v2.1/*.js.map
/build/super-token-v2.1/*.asset.php

# Super Token CDN hand-off bundles — build artifacts staged by build:super-token:bundle for the
# manual copy into the woocommerce-scripts repo (the tracked CDN source). Not served by the plugin.
# The runtime bundle plus the per-variant JS/CSS for the legacy v1//v2.1/ retrocompat paths (PSW-4417).
/assets/js/checkouts/super-token/super-token.bundle.js
/assets/js/checkouts/super-token/super-token-v2.bundle.js
/assets/js/checkouts/super-token/super-token-v2.1.bundle.js
/assets/css/checkouts/super-token/super-token-v2.bundle.min.css
/assets/css/checkouts/super-token/super-token-v2.1.bundle.min.css

# IA Files
.personal-agents
.claude/settings.local.json
.claude/tasks/
.claude/regression-*.json
