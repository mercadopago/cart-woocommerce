# Config local por dev da homologação. Copie para .deploy.env (gitignored):
#   cp .deploy.env.example .deploy.env  &&  edite
#
# Os domínios usam automaticamente o seu usuário de rede ($SMOOTH_USER):
#   https://<SMOOTH_USER>-<site>.ppolimpo.io
# então normalmente você só precisa apontar a SUA instância.

# Instância AWS (do smooth) onde suas lojas vão rodar.
# Veja as suas com:  smooth get-my-instances
HOMOLOG_INSTANCE=

# --- Overrides opcionais ---
# HOMOLOG_PREFIX=        # default: seu $SMOOTH_USER (prefixo dos subdomínios)
# HOMOLOG_BASE_DOMAIN=   # default: ppolimpo.io
# HOMOLOG_SSH_KEY=       # default: ~/.ssh/id_aws
# PHP_VERSION=           # default: 7.4
