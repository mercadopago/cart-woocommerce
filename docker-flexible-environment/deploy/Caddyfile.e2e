(shared_store) {
	handle /wp-admin/admin-ajax.php {
		reverse_proxy {args[0]}
	}
	@private_admin path /wp-admin /wp-admin/* /wp-login.php /wp-login.php/* /xmlrpc.php /xmlrpc.php/* /wp-content/debug.log /wp-content/debug.log/*
	handle @private_admin {
		respond 403
	}
	handle {
		reverse_proxy {args[0]}
	}
}

e2e-staging-mla.ppolimpo.io {
	import shared_store wp-staging-mla:80
}

e2e-homol-mla.ppolimpo.io {
	import shared_store wp-homol-mla:80
}

